# Laventana - environment variables
# Copy this file to .env.local (local dev) or set these in Vercel dashboard
# (Settings -> Environment Variables) for each project.

VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_GEMINI_TRANSLATION_MODEL=gemini-flash-lite-latest
VITE_WHATSAPP_PHONE=9647509085555
VITE_ADMIN_PASSCODE=RamYar

# Set to "true" ONLY on the admin-only Vercel project (laventana1)
# so that deployment shows only the admin panel at its root URL.
VITE_ADMIN_ONLY=false

# ---- Server-side only (Vercel dashboard, NOT the client) ----
# These power the Telegram webhook (api/telegram.js) and the lock KV store.
# Vercel KV store: create one in the Vercel dashboard (Storage tab) and
# copy its KV_REST_API_URL + KV_REST_API_TOKEN here.
KV_REST_API_URL=your_kv_rest_api_url
KV_REST_API_TOKEN=your_kv_rest_api_token
# Optional secret for the Telegram webhook (must match what set-webhook.mjs sends).
TELEGRAM_WEBHOOK_SECRET=