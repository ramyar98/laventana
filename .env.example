# Laventana - environment variables
# Copy this file to .env.local (local dev) or set these in the Vercel dashboard
# (Settings -> Environment Variables) for each project.

# ---- Client-side (Vite) ----
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_GEMINI_TRANSLATION_MODEL=gemini-flash-lite-latest
VITE_WHATSAPP_PHONE=9647509085555
VITE_ADMIN_PASSCODE=RamYar

# Set to "true" ONLY on the admin-only Vercel project (laventana1)
# so that deployment shows only the admin panel at its root URL.
VITE_ADMIN_ONLY=false

# ---- Server-side only (Vercel dashboard, api/* functions) ----
# Primary lock-store backend: Vercel Global Config.
# GLOBAL_CONFIG = connection string, auto-created when you connect a Global
# Config store to the project: https://global-config.vercel.com/<storeId>?token=<readToken>
GLOBAL_CONFIG=
# Vercel API access token (vercel.com/account/settings/tokens, Full Access)
VERCEL_API_TOKEN=
# Team slug used when writing to the Global Config (usually your Vercel team name)
VERCEL_TEAM_SLUG=laventana

# Fallback lock-store backend (used only if GLOBAL_CONFIG/VERCEL_API_TOKEN
# are unset): Upstash REST credentials from a free DB at upstash.com.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional Telegram webhook secret (code currently does NOT enforce it)
TELEGRAM_WEBHOOK_SECRET=